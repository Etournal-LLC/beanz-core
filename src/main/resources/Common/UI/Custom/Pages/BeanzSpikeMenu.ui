$C = "../Common.ui";
$Sounds = "../Sounds.ui";

// BS0 spike: clickable menu test. Throwaway.
$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 620);

    #Title {
      $C.@Title {
        @Text = "Shards Spike Menu";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);

      Label {
        Anchor: (Bottom: 12, Horizontal: 8);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, Wrap: true, FontSize: 16);
        Text: "Click Bind to add a test shard to your saved list. Relog and reopen to check it was kept.";
      }

      Label #Status {
        Anchor: (Bottom: 16, Horizontal: 8);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, Wrap: true, FontSize: 15, TextColor: #ffcc00);
        Text: "...";
      }

      Group {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@TextButton #BindButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Width: 150, Right: 6);
          Text: "Bind";
        }

        $C.@SecondaryTextButton #ClearButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Width: 150, Left: 6, Right: 6);
          Text: "Clear";
        }

        $C.@SecondaryTextButton #CloseButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Width: 150, Left: 6);
          Text: "Close";
        }
      }
    }
  }
}

$C.@BackButton {}
